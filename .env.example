# Practice Numbers settings. Copy this file to .env and fill it in.
# Never put the real values in GitHub, email or chat.

# design (Hostinger, Open Dental demo database) or live (office server)
TDC_STAGE=design

# Port to listen on. Office server: 3104. On Hostinger, leave it out (Hostinger sets it).
PORT=3104
# Hostinger only: HOST=0.0.0.0   (ignored in the live stage, which always uses 127.0.0.1)

# From the Dashboard: Settings > Modules > Add a module (id "numbers"). Shown once.
MODULE_SECRET=

# The Open Dental gateway, and this module's own key ("numbers") from:
#   node gateway/cli.js new-key numbers      (in opendental-claude)
GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_KEY=

# Optional
# PATIENT_LISTS=on        off hides the A/R family and claims lists
# COUNT_CODES=D2740,D6058,D6065,D6010,D2950   codes counted on the Production page
# TDC_TZ=America/Los_Angeles
